storage "raft" {
  path    = "/openbao/data"
  node_id = "{{ openbao_node_id }}"
}

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = true
}

api_addr     = "https://{{ openbao_domain }}"
cluster_addr = "https://{{ openbao_domain }}:8201"

ui            = true

# Journal d'audit sur la sortie standard du conteneur (docker logs openbao)
audit "file" "stdout" {
  description = "Journal d'audit (docker logs openbao)"
  options {
    file_path = "stdout"
  }
}
