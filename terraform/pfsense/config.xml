<?xml version="1.0"?>
<pfsense>
  <version>2.8.1</version> <system>
    <hostname>pfsense</hostname>
    <domain>home.arpa</domain>
    <enablesshd>yes</enablesshd>
    <sshport></sshport>
    
    <user>
      <name>admin</name>
      <descr><![CDATA[System Administrator]]></descr>
      <scope>system</scope>
      <groupname>admins</groupname>
      <priv>user-shell-access</priv>
      <authorizedkeys>ssh-rsa  root@ansible-node</authorizedkeys>
    </user>
  </system>

  <interfaces>
    <wan>
      <if>vtnet0</if>
      <ipaddr>10.168.168.231</ipaddr>
      <subnet>24</subnet>
      <gateway>10.168.168.1</gateway>
    </wan>
    <lan>
      <if>vtnet1</if>
      <ipaddr>192.168.1.2</ipaddr>
      <subnet>24</subnet>
    </lan>
  </interfaces>

  <filter>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source><address>any</address></source>
      <destination><address>any</address></destination>
      <descr>Allow all on LAN for Ansible</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <source><address>any</address></source>
      <destination><network>wanip</network><port>22</port></destination>
      <descr>Allow SSH on WAN for Ansible</descr>
    </rule>
  </filter>
</pfsense>
